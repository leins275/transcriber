vexa/
specs/_intake/*/worktrees/
target/
node_modules/
dist/
build/
# E12: scripts/tests' own pytest run leaves these behind (make test must
# leave `git status` clean, NFR-6).
__pycache__/
# The staged engine payload: built libraries plus ~180 MB of pinned
# third-party binaries, all reproducible from the build and the pin table, so
# never tracked. The directory itself must still exist on a clean checkout --
# tauri-build's bundleResources errors if the source path is missing -- so
# ignore its contents but keep the .gitkeep.
apps/desktop/src-tauri/resources/engine/*
!apps/desktop/src-tauri/resources/engine/.gitkeep
# Where `stage_engine_payload.py` caches those downloads between builds.
.cache/

# Dev app folder assembled by scripts/dev_app_dir.py (hardlinks to models
# and the staged payload; never committed).
.devapp/
